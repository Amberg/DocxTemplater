<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <!-- all language packages share one namespace, so a single using covers every installed language -->
    <RootNamespace>DocxTemplater.Localization</RootNamespace>
    <Description>Swiss German (de-CH) error messages for DocxTemplater. Register with TemplateErrorMessages.Default.AddSwissGerman().</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DocxTemplater\DocxTemplater.csproj" />
    <ProjectReference Include="..\DocxTemplater.Localization.German\DocxTemplater.Localization.German.csproj" />
  </ItemGroup>
</Project>
