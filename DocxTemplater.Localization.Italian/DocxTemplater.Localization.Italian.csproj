<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <!-- all language packages share one namespace, so a single using covers every installed language -->
    <RootNamespace>DocxTemplater.Localization</RootNamespace>
    <Description>Italian error messages for DocxTemplater. Register with TemplateErrorMessages.Default.AddItalian().</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DocxTemplater\DocxTemplater.csproj" />
  </ItemGroup>
</Project>
